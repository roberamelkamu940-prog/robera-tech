<%- include('../partials/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="fw-bold mb-4 text-dark"><i class="bi bi-plus-circle-fill me-2 text-primary"></i>Create New Course</h2>
                
                <form action="/admin/courses/create" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Course Title</label>
                        <input type="text" name="title" class="form-control form-control-lg" placeholder="e.g., Advanced Node.js & Microservices" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="description" class="form-control" rows="4" placeholder="What will students learn in this course?" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Price (ETB)</label>
                        <input type="number" step="0.01" name="price" class="form-control form-control-lg" value="500.00" required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">URL Slug (Optional)</label>
                        <input type="text" name="slug" class="form-control" placeholder="e.g., advanced-nodejs">
                        <small class="text-muted">Leave blank to generate automatically from the title.</small>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/student/dashboard" class="text-decoration-none text-secondary fw-bold">&larr; Back to Dashboard</a>
                        <button type="submit" class="btn btn-primary btn-lg fw-bold px-4">Publish Course &rarr;</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>