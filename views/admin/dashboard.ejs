<%- include('../partials/header') %>

<div class="row">
    <!-- Sidebar Navigation -->
    <div class="col-md-3 mb-4">
        <div class="list-group shadow-sm">
            <a href="/admin/dashboard" class="list-group-item list-group-item-action active">Dashboard Overview</a>
            <a href="/admin/courses" class="list-group-item list-group-item-action">Manage Courses</a>
            <a href="/admin/students" class="list-group-item list-group-item-action">Manage Students</a>
            <form action="/auth/logout" method="POST" class="list-group-item"><button type="submit" class="btn btn-link text-danger p-0">Sign out</button></form>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-md-9">
        <div class="p-4 mb-4 bg-white rounded shadow-sm border">
            <h2>Welcome back, <%= user.name || user.email %>.</h2>
            <p class="text-muted mb-0">Manage course content and keep track of platform activity.</p>
        </div>

        <div class="row g-3" aria-label="Platform overview">
            <div class="col-6 col-xl-3"><div class="content-panel h-100"><p class="small text-muted mb-1">Students</p><p class="h2 mb-0"><%= stats.students %></p></div></div>
            <div class="col-6 col-xl-3"><div class="content-panel h-100"><p class="small text-muted mb-1">Courses</p><p class="h2 mb-0"><%= stats.courses %></p></div></div>
            <div class="col-6 col-xl-3"><div class="content-panel h-100"><p class="small text-muted mb-1">Enrollments</p><p class="h2 mb-0"><%= stats.enrollments %></p></div></div>
            <div class="col-6 col-xl-3"><div class="content-panel h-100"><p class="small text-muted mb-1">Lessons</p><p class="h2 mb-0"><%= stats.lessons %></p></div></div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a href="/admin/courses" class="btn btn-success">Manage courses and lessons</a>
            <a href="/admin/students" class="btn btn-outline-success">View student accounts</a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>