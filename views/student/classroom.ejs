<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course.title %> | Robera Tech Classroom</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased h-screen flex flex-col overflow-hidden">

    <!-- Top Navigation Bar -->
    <header class="bg-slate-900 border-b border-slate-800 px-6 py-3 flex justify-between items-center shrink-0">
        <div class="flex items-center gap-4">
            <a href="/student/dashboard" class="text-slate-400 hover:text-white transition-colors text-sm flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
            <span class="text-slate-700">|</span>
            <h1 class="text-base font-bold text-white truncate max-w-xl"><%= course.title %></h1>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs bg-emerald-500/10 text-emerald-400 px-3 py-1 rounded-full border border-emerald-500/20 font-semibold">Enrolled Student</span>
        </div>
    </header>

    <!-- Main Classroom Layout (Split Screen) -->
    <div class="flex flex-grow overflow-hidden">
        
        <!-- Left Side: Video Player & Lesson Details -->
        <main class="flex-grow flex flex-col overflow-y-auto p-6 lg:p-8 bg-slate-950">
            <!-- Video Container -->
            <div class="w-full aspect-video bg-black rounded-2xl overflow-hidden border border-slate-800 shadow-2xl relative flex items-center justify-center">
                <% if (lessons && lessons.length > 0) { %>
                    <!-- Dynamic Video Frame / Placeholder -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center bg-slate-900">
                        <div class="w-20 h-20 bg-blue-600 rounded-full flex items-center justify-center text-white text-2xl shadow-xl shadow-blue-600/30 cursor-pointer hover:bg-blue-500 transition-all">
                            <i class="fa-solid fa-play ml-1"></i>
                        </div>
                        <p class="text-slate-300 font-medium mt-4 text-sm" id="current-lesson-title"><%= lessons[0].title %></p>
                        <span class="text-slate-500 text-xs mt-1">High-Definition Secure Stream</span>
                    </div>
                <% } else { %>
                    <div class="text-center p-6">
                        <i class="fa-solid fa-video-slash text-slate-600 text-3xl mb-2"></i>
                        <p class="text-slate-400 text-sm">No lessons uploaded for this course yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- Lesson Info & Notes -->
            <div class="mt-6 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg">
                <h2 class="text-xl font-bold text-white">About This Module</h2>
                <p class="text-slate-300 text-sm mt-2 leading-relaxed">
                    <%= course.description %>
                </p>
            </div>
        </main>

        <!-- Right Side: Course Syllabus / Lesson Playlist Sidebar -->
        <aside class="w-96 bg-slate-900 border-l border-slate-800 flex flex-col shrink-0 overflow-hidden hidden lg:flex">
            <div class="p-5 border-b border-slate-800 bg-slate-900/50">
                <h3 class="font-bold text-white text-sm">Course Syllabus</h3>
                <p class="text-slate-400 text-xs mt-0.5"><%= lessons ? lessons.length : 0 %> lessons available</p>
            </div>
            
            <div class="flex-grow overflow-y-auto divide-y divide-slate-800/60">
                <% if (lessons && lessons.length > 0) { %>
                    <% lessons.forEach((lesson, index) => { %>
                        <div class="p-4 hover:bg-slate-800/50 transition-all cursor-pointer flex items-start gap-3 group">
                            <span class="w-6 h-6 rounded-full bg-slate-800 border border-slate-700 text-slate-400 flex items-center justify-center text-xs shrink-0 mt-0.5 group-hover:border-blue-500 group-hover:text-blue-400 transition-colors">
                                <%= index + 1 %>
                            </span>
                            <div>
                                <h4 class="text-sm font-semibold text-slate-200 group-hover:text-white"><%= lesson.title %></h4>
                                <span class="text-xs text-slate-500 flex items-center gap-1 mt-1">
                                    <i class="fa-regular fa-clock"></i> <%= lesson.duration || '15 min' %>
                                </span>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="p-6 text-center text-slate-500 text-xs">
                        No lessons listed.
                    </div>
                <% } %>
            </div>
        </aside>

    </div>

</body>
</html>