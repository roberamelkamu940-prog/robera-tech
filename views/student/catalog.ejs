<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Robera Tech</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Navbar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-900/80 border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-2">
                <span class="bg-blue-600 text-white p-2 rounded-lg text-lg"><i class="fa-solid fa-code"></i></span>
                Robera<span class="text-blue-500">Tech</span>
            </a>
            <div class="flex items-center gap-6">
                <a href="/student/dashboard" class="text-sm font-medium text-slate-300 hover:text-blue-400">Dashboard</a>
                <a href="/auth/logout" class="bg-slate-800 hover:bg-red-600/20 text-slate-300 hover:text-red-400 px-4 py-2 rounded-lg text-sm font-semibold transition-all border border-slate-700">Logout</a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-6 py-12 w-full flex-grow">
        
        <!-- Header Banner -->
        <div class="mb-10 text-center md:text-left flex flex-col md:flex-row justify-between items-center gap-6">
            <div>
                <span class="text-blue-400 text-xs font-semibold uppercase tracking-wider bg-blue-500/10 px-3 py-1 rounded-full border border-blue-500/20">Catalog</span>
                <h1 class="text-3xl font-extrabold text-white mt-3">Explore Professional Tech Courses</h1>
                <p class="text-slate-400 text-sm mt-1">Level up your software engineering skills with industry-standard modules.</p>
            </div>
            <!-- Search Filter Bar -->
            <form action="/student/courses" method="GET" class="flex gap-2 w-full md:w-auto">
                <input type="text" name="search" placeholder="Search courses..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" class="bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500 w-full md:w-64">
                <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-lg shadow-blue-600/20">Search</button>
            </form>
        </div>

        <!-- Course Grid -->
        <% if (courses && courses.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <% courses.forEach(course => { %>
                    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl hover:border-slate-700 transition-all flex flex-col justify-between group">
                        <div class="p-6">
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-xs font-medium bg-blue-500/10 text-blue-400 px-3 py-1 rounded-full border border-blue-500/20"><%= course.category %></span>
                                <span class="text-xs font-semibold text-slate-400 bg-slate-800 px-2.5 py-1 rounded-md"><%= course.level %></span>
                            </div>
                            <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors"><%= course.title %></h3>
                            <p class="text-slate-400 text-sm mt-3 line-clamp-3 leading-relaxed"><%= course.description %></p>
                        </div>
                        <div class="p-6 pt-0 flex items-center justify-between border-t border-slate-800/60 mt-4 pt-4">
                            <span class="text-xl font-extrabold text-white">$<%= course.price %></span>
                            <a href="/student/checkout/<%= course.id %>" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-5 py-2.5 rounded-xl text-sm transition-all shadow-lg shadow-blue-600/20 flex items-center gap-2">
                                Enroll Now <i class="fa-solid fa-arrow-right text-xs"></i>
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 bg-slate-900/40 border border-slate-800 rounded-2xl">
                <i class="fa-solid fa-folder-open text-4xl text-slate-600 mb-3"></i>
                <h3 class="text-lg font-bold text-white">No courses found</h3>
                <p class="text-slate-400 text-sm mt-1">Try adjusting your search query or check back later.</p>
            </div>
        <% } %>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-6 text-center text-slate-500 text-xs">
        <p>&copy; 2026 Robera Tech. Built with Enterprise-Grade Node.js & MySQL.</p>
    </footer>

</body>
</html>