<%- include('../partials/header') %>

<div class="container py-4">
    <div class="row">
        <!-- Main Course Info -->
        <div class="col-md-8">
            <div class="p-4 bg-white border rounded shadow-sm mb-4">
                <h1 class="fw-bold text-dark mb-3"><%= course.title %></h1>
                <p class="text-muted lead mb-4"><%= course.description %></p>
                <hr>
                <h4 class="mb-3">What you'll learn</h4>
                <ul class="text-muted ps-3 mb-0">
                    <li>Core concepts and hands-on practical applications</li>
                    <li>Industry best practices and production-ready code structure</li>
                    <li>Guidance directly tailored for professional growth</li>
                </ul>
            </div>
        </div>

        <!-- Enrollment / Checkout Sidebar -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <h3 class="fw-bold text-primary mb-3"><%= course.price > 0 ? course.price + ' ETB' : 'Free Course' %></h3>
                    
                    <% if (isEnrolled) { %>
                        <div class="alert alert-success mb-3">You are enrolled in this course!</div>
                        <a href="/student/learn/<%= course.id %>" class="btn btn-success w-100 py-2 fw-bold">Continue Learning</a>
                    <% } else if (Number(course.price) <= 0) { %>
                        <form action="/student/enroll/<%= course.id %>" method="POST">
                            <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Enroll for free</button>
                        </form>
                    <% } else { %>
                        <form action="/student/checkout/<%= course.id %>" method="POST">
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">Enroll Now via Chapa</button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>