<%- include('../partials/header') %>

<main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <p class="text-uppercase small fw-bold text-success mb-1">Learn at your pace</p>
            <h1 class="h2 mb-0">Course catalog</h1>
        </div>
        <form action="/student/courses" method="GET" class="d-flex gap-2">
            <label class="visually-hidden" for="course-search">Search courses</label>
            <input id="course-search" class="form-control" type="search" name="search" value="<%= searchQuery || '' %>" placeholder="Search courses">
            <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
    </div>
    <% if (courses.length) { %>
        <div class="row g-3">
            <% courses.forEach(course => { %>
                <article class="col-md-6 col-xl-4">
                    <div class="content-panel h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <span class="badge text-bg-success"><%= course.category %></span>
                            <span class="small text-muted"><%= course.level %></span>
                        </div>
                        <h2 class="h4"><%= course.title %></h2>
                        <p class="text-muted flex-grow-1"><%= course.description %></p>
                        <p class="small text-muted"><%= course.lesson_count %> lessons</p>
                        <% if (course.is_enrolled) { %>
                            <a href="/student/learn/<%= course.id %>" class="btn btn-success">Continue learning</a>
                        <% } else if (!user) { %>
                            <a href="/auth/login" class="btn btn-outline-success">Sign in to enroll</a>
                        <% } else if (Number(course.price) > 0) { %>
                            <form action="/student/checkout/<%= course.id %>" method="POST"><button type="submit" class="btn btn-success w-100">Enroll · <%= course.price %> ETB</button></form>
                        <% } else { %>
                            <form action="/student/enroll/<%= course.id %>" method="POST"><button type="submit" class="btn btn-success w-100">Enroll for free</button></form>
                        <% } %>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-state"><h2 class="h4">No courses found</h2><p class="mb-0">Try another search term.</p></div>
    <% } %>
</main>

<%- include('../partials/footer') %>