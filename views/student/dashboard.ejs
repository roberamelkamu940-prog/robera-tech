<%- include('../partials/header') %>

<div class="container py-4">
    <!-- Welcome Banner -->
    <div class="p-4 mb-4 bg-primary text-white rounded shadow-sm">
        <h1 class="fw-bold">Welcome back, <%= user.name || user.email || 'Student' %>!</h1>
        <p class="mb-0 text-white-50">Here is an overview of your enrolled courses and learning progress.</p>
    </div>

    <!-- Enrolled Courses Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-dark">My Enrolled Courses</h3>
        <a href="/student/courses" class="btn btn-outline-primary btn-sm fw-bold">Explore More Courses</a>
    </div>

    <% if (enrolledCourses && enrolledCourses.length > 0) { %>
        <div class="row">
            <% enrolledCourses.forEach(course => { %>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark"><%= course.title %></h5>
                            <p class="card-text text-muted small flex-grow-1">
                                <%= course.description ? course.description.substring(0, 90) : 'No description provided.' %>...
                            </p>
                            <div class="d-flex justify-content-between small text-muted mb-2">
                                <span>Learning progress</span><span><%= course.progress || 0 %>%</span>
                            </div>
                            <div class="progress mb-3" role="progressbar" aria-label="Course progress" aria-valuenow="<%= course.progress || 0 %>" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: <%= course.progress || 0 %>%"></div>
                            </div>
                            <a href="/student/course/<%= course.id %>" class="btn btn-success btn-sm w-100 mt-3 fw-bold">Continue Learning</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="text-center p-5 bg-white border rounded shadow-sm">
            <h5 class="text-muted mb-3">You are not enrolled in any courses yet.</h5>
            <a href="/student/courses" class="btn btn-primary px-4 py-2 fw-bold">Browse Catalog</a>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>