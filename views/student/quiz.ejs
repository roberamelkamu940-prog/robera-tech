<%- include('../partials/header') %>

<main class="container py-5">
    <div class="row justify-content-center">
        <section class="col-lg-8">
            <a href="/student/learn/<%= quiz.course_id %>" class="text-decoration-none">&larr; <%= quiz.course_title %></a>
            <h1 class="h2 mt-3"><%= quiz.title %></h1>
            <p class="text-muted">Choose one answer for each question.</p>

            <% if (attempt) { %>
                <div class="alert alert-success" role="status">
                    Your score: <strong><%= attempt.score %> / <%= attempt.total_questions %></strong>
                </div>
            <% } %>
            <% if (questions.length === 0) { %>
                <div class="empty-state">This quiz does not have any questions yet.</div>
            <% } else if (!attempt) { %>
                <form action="/student/quiz/<%= quiz.id %>/submit" method="POST" class="quiz-form">
                    <% questions.forEach((question, index) => { %>
                        <fieldset class="content-panel mb-3">
                            <legend class="h5"><%= index + 1 %>. <%= question.question %></legend>
                            <% [
                                ['a', question.option_a],
                                ['b', question.option_b],
                                ['c', question.option_c],
                                ['d', question.option_d]
                            ].forEach(option => { %>
                                <label class="quiz-option">
                                    <input type="radio" name="answers[<%= question.id %>]" value="<%= option[0] %>" required>
                                    <span><%= option[1] %></span>
                                </label>
                            <% }) %>
                        </fieldset>
                    <% }) %>
                    <button type="submit" class="btn btn-success">Submit answers</button>
                </form>
            <% } else { %>
                <a class="btn btn-outline-success" href="/student/quiz/<%= quiz.id %>">Try again</a>
            <% } %>
        </section>
    </div>
</main>

<%- include('../partials/footer') %>