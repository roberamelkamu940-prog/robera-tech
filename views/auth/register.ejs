<%- include('../partials/header') %>

<section class="form-page">
    <p class="text-uppercase small fw-bold text-success mb-2">Student registration</p>
    <h1 class="h3 mb-2">Create your account</h1>
    <p class="text-muted mb-4">Your account gives you a private place to learn and track progress.</p>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <form action="/auth/register" method="POST">
        <div class="mb-3">
            <label for="name" class="form-label">Full name</label>
            <input id="name" type="text" name="name" class="form-control" maxlength="100" autocomplete="name" value="<%= typeof values !== 'undefined' && values.name ? values.name : '' %>" required>
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input id="email" type="email" name="email" class="form-control" autocomplete="email" value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>" required>
        </div>
        <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input id="password" type="password" name="password" class="form-control" minlength="8" autocomplete="new-password" required>
            <div class="form-text">Use at least 8 characters.</div>
        </div>
        <button type="submit" class="btn btn-success w-100">Create account</button>
    </form>
    <p class="text-center text-muted mt-4 mb-0">Already registered? <a href="/auth/login">Sign in</a></p>
</section>

<%- include('../partials/footer') %>