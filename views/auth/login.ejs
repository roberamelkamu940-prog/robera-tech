<%- include('../partials/header') %>

<section class="form-page">
    <p class="text-uppercase small fw-bold text-success mb-2">Robera Tech Learning</p>
    <h1 class="h3 mb-2">Welcome back</h1>
    <p class="text-muted mb-4">Sign in to continue your courses.</p>
    <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
    <form action="/auth/login" method="POST">
        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input id="email" type="email" name="email" class="form-control" autocomplete="email" required>
        </div>
        <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input id="password" type="password" name="password" class="form-control" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-success w-100">Sign in</button>
    </form>
    <p class="text-center text-muted mt-4 mb-0">New here? <a href="/auth/register">Create a student account</a></p>
</section>

<%- include('../partials/footer') %>