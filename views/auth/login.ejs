<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Robera Tech | Empowering Future Software Engineers</title>
    <!-- Tailwind CSS CDN for instant modern styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0284c7 100%);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Sticky Glassmorphism Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-900/80 border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <a href="/" class="text-2xl font-extrabold tracking-tight text-white flex items-center gap-2">
                <span class="bg-blue-600 text-white p-2 rounded-lg text-lg"><i class="fa-solid fa-code"></i></span>
                Robera<span class="text-blue-500">Tech</span>
            </a>
            <nav class="hidden md:flex gap-8 items-center font-medium text-slate-300 text-sm">
                <a href="/student/courses" class="hover:text-blue-400 transition-colors">Browse Courses</a>
                <a href="#features" class="hover:text-blue-400 transition-colors">Features</a>
                <a href="/auth/login" class="hover:text-blue-400 transition-colors">Sign In</a>
                <a href="/auth/register" class="bg-blue-600 hover:bg-blue-500 text-white px-5 py-2.5 rounded-full font-semibold transition-all shadow-lg shadow-blue-600/30">
                    Get Started Free
                </a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-20 pb-32 gradient-bg">
        <div class="max-w-7xl mx-auto px-6 text-center relative z-10">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20 mb-6">
                <i class="fa-solid fa-bolt text-yellow-400"></i> Next-Gen Tech Education
            </span>
            <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white leading-tight mb-6">
                Master Software Engineering <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">With Real-World Projects</span>
            </h1>
            <p class="text-lg md:text-xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed">
                Unlock career-ready skills in Full-Stack Development, Database Architecture, and Cloud Systems. Fast-track your tech career with interactive video classrooms and secure instant enrollment.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="/student/courses" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-500 text-white font-bold px-8 py-4 rounded-xl text-lg shadow-xl shadow-blue-600/30 transition-all flex items-center justify-center gap-3">
                    Explore Courses <i class="fa-solid fa-arrow-right text-sm"></i>
                </a>
                <a href="/auth/login" class="w-full sm:w-auto glass-card hover:bg-white/10 text-white font-semibold px-8 py-4 rounded-xl text-lg transition-all border border-slate-700 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-play text-xs text-blue-400"></i> Watch Preview
                </a>
            </div>

            <!-- Stats Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto mt-20 p-6 rounded-2xl glass-card">
                <div>
                    <h3 class="text-3xl font-bold text-white">100%</h3>
                    <p class="text-xs text-slate-400 mt-1">Practical Learning</p>
                </div>
                <div>
                    <h3 class="text-3xl font-bold text-white">Chapa</h3>
                    <p class="text-xs text-slate-400 mt-1">Instant Direct Checkout</p>
                </div>
                <div>
                    <h3 class="text-3xl font-bold text-white">24/7</h3>
                    <p class="text-xs text-slate-400 mt-1">Classroom Access</p>
                </div>
                <div>
                    <h3 class="text-3xl font-bold text-white">Verified</h3>
                    <p class="text-xs text-slate-400 mt-1">Certificates</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-10">
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-400 text-sm">
            <p>&copy; 2026 Robera Tech. All rights reserved.</p>
            <p class="flex items-center gap-2">
                Powered by <span class="text-blue-400 font-semibold">Chapa Gateway</span> & <span class="text-blue-400 font-semibold">Node.js Engine</span>
            </p>
        </div>
    </footer>

</body>
</html>