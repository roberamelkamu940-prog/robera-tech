<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Robera Tech' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="site-header">
        <a class="site-brand" href="/">Robera <span>Tech</span></a>
        <nav class="site-nav" aria-label="Main navigation">
            <% if (typeof user !== 'undefined' && user) { %>
                <% if (user.role === 'admin') { %>
                    <a href="/admin/dashboard">Admin</a>
                    <a href="/admin/courses">Courses</a>
                    <a href="/admin/students">Students</a>
                <% } else { %>
                    <a href="/student/dashboard">My learning</a>
                    <a href="/student/courses">Catalog</a>
                    <a href="/student/profile">Profile</a>
                <% } %>
                <form action="/auth/logout" method="POST" class="logout-form"><button type="submit">Sign out</button></form>
            <% } else { %>
                <a href="/auth/login">Sign in</a>
                <a href="/auth/register">Register</a>
            <% } %>
        </nav>
    </header>
    <main class="site-main">