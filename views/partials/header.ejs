<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Robera Tech' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header style="background: #2c3e50; padding: 15px 30px; color: white; display: flex; justify-content: space-between; align-items: center;">
        <h2 style="margin: 0; color: #fff;">Robera Tech</h2>
        <nav>
            <% if (typeof user !== 'undefined' && user) { %>
                <span style="margin-right: 15px;">Logged in as: <strong><%= user.name %></strong> (<%= user.role %>)</span>
                <a href="/auth/logout" style="color: #ff6b6b; text-decoration: none; font-weight: bold;">Logout</a>
            <% } else { %>
                <a href="/auth/login" style="color: #fff; text-decoration: none; margin-right: 15px;">Login</a>
                <a href="/auth/register" style="color: #fff; text-decoration: none;">Register</a>
            <% } %>
        </nav>
    </header>